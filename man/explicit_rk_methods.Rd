\item{alg}{The stiff method of the automatic switch.}
}
\value{
An algorithm object.
}
\description{
The explicit Runge-Kutta methods of the OrdinaryDiffEq sublibraries, for
\code{\link[=solve]{solve()}} on ODE problems. All take \code{stage_limiter(u, integ, p, t)} and
\code{step_limiter(u, integ, p, t)} (functions returning the limited state,
applied to every stage and to every step, as the SSP methods use them)
and \code{thread} (ignored; R evaluates the stages in turn). The low storage
methods apply only the step limiter, as their out of place forms in
OrdinaryDiffEq.
}
\details{
\itemize{
\item Low order (OrdinaryDiffEqLowOrderRK): \code{Heun()}, \code{Ralston()},
\code{Ralston4()}, \code{RKM()}, \code{OwrenZen3()}, \code{OwrenZen4()}, \code{OwrenZen5()},
\code{BS5()}, \code{Alshina2()}, \code{Alshina3()}, \code{Alshina6()}, \code{Stepanov5()},
\code{SIR54()}, \code{MSRK5()}, \code{MSRK6()}, \code{PSRK3p5q4()}, \code{PSRK3p6q5()},
\code{PSRK4p7q6()}.
\item High order: \code{DP8()}, \code{TanYam7()}, \code{TsitPap8()}, \code{PFRK87()},
\code{Feagin10()}, \code{Feagin12()}, \code{Feagin14()}, \code{RKV76IIa()}.
\item Strong stability preserving (OrdinaryDiffEqSSPRK): \code{SSPRK22()},
\code{SSPRK33()}, \code{SSPRK53()}, \code{SSPRK53_2N1()}, \code{SSPRK53_2N2()},
\code{SSPRK53_H()}, \code{SSPRK63()}, \code{SSPRK73()}, \code{SSPRK83()}, \code{SSPRK43()},
\code{SSPRK432()}, \code{SSPRK932()}, \code{SSPRK54()}, \code{SSPRK104()}, \code{KYKSSPRK42()}.
\item Low storage (OrdinaryDiffEqLowStorageRK): \code{ORK256()},
\code{CarpenterKennedy2N54()}, \code{SHLDDRK64()}, \code{SHLDDRK52()},
\code{SHLDDRK_2N()}, \code{DGLDDRK73_C()}, \code{DGLDDRK84_C()}, \code{DGLDDRK84_F()},
\code{NDBLSRK124()}, \code{NDBLSRK134()}, \code{NDBLSRK144()}, \code{CFRLDDRK64()},
\code{TSLDDRK74()}, \code{RK46NL()}, the \verb{CKLLSRK*} and \verb{ParsaniKetchesonDeconinck*}
families, the \verb{AlJahdali*} families and the adaptive \code{RDPK3Sp35()},
\code{RDPK3SpFSAL35()}, \code{RDPK3Sp49()}, \code{RDPK3SpFSAL49()}, \code{RDPK3Sp510()},
\code{RDPK3SpFSAL510()} (with their PID step size controllers).
\item \code{AutoDP5(alg)} switches between \code{DP5()} and the stiff method \code{alg};
\code{SplitEuler()} is the explicit Euler method for split problems.
}

Each method has the order, embedded error estimate and step size
controller of its Julia version; dense output is cubic Hermite
interpolation for methods that evaluate the derivative at the new state
and linear otherwise.
}
\examples{
prob <- ODEProblem(function(u, p, t) -u, 1, c(0, 1))
solve(prob, OwrenZen5())(1)
solve(prob, SSPRK33(), dt = 0.1)(1)
solve(prob, RDPK3Sp35())(1)
}
